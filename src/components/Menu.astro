---
import { menu } from '../data/site';
---

<section class="menu section" id="menu">
  <div class="shell">
    <header class="menu__head">
      <h2 class="menu__title">The menu</h2>
      <p class="menu__lede">
        Short by design. Chicken comes bone-in or boneless and is fried twice,
        then tossed in the sauce you pick. Prices in CAD.
      </p>
    </header>

    <div class="menu__groups" data-reveal-group>
      {
        menu.map((group) => (
          <div class={`group${group.items.length <= 4 ? ' group--tight' : ''}`} data-reveal>
            <h3 class="group__name">{group.name}</h3>
            {group.note && group.items && group.name === 'Chicken' && (
              <p class="group__note">{group.note}</p>
            )}
            <ul class="group__items">
              {group.items.map((item) => (
                <li class="row">
                  <span class="row__name">
                    {item.name}
                    {item.tag && (
                      <span class={`tag${item.tag === 'Most ordered' ? ' tag--star' : ''}`}>
                        {item.tag}
                      </span>
                    )}
                  </span>
                  <span class="row__leader" aria-hidden="true" />
                  <span class="row__price">{item.price}</span>
                </li>
              ))}
            </ul>
            {group.note && group.name !== 'Chicken' && (
              <p class="group__note group__note--foot">{group.note}</p>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .menu { background: var(--bg); }

  .menu__head { max-width: 44ch; margin-bottom: var(--space-xl); }
  .menu__title {
    font-size: var(--step-4);
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  .menu__lede {
    margin-top: var(--space-s);
    color: var(--muted);
    font-size: var(--step-1);
    line-height: 1.55;
  }

  .menu__groups {
    display: grid;
    gap: clamp(2.75rem, 5vw, 4rem);
  }

  .group__name {
    font-size: var(--step-2);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--primary);
    padding-bottom: var(--space-xs);
    border-bottom: 2px solid var(--primary);
  }
  .group__note {
    margin-top: var(--space-xs);
    font-size: var(--step--1);
    color: var(--muted);
  }
  .group__note--foot { margin-top: var(--space-m); }

  .group__items {
    list-style: none;
    padding: 0;
    margin-top: var(--space-m);
    columns: 2;
    column-gap: clamp(2rem, 5vw, 4.5rem);
  }
  .group--tight .group__items { columns: 1; max-width: 34rem; }

  .row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding-block: 0.55rem;
    break-inside: avoid;
  }
  .row:first-child { padding-top: 0; }

  @media (max-width: 620px) {
    .group__items { columns: 1; }
  }

  .row__name {
    font-weight: 500;
    font-size: var(--step-0);
  }
  .row__leader {
    flex: 1;
    border-bottom: 1px dotted var(--hairline-strong);
    transform: translateY(-0.25em);
    min-width: 1.5rem;
  }
  .row__price {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.01em;
  }
  .row__price::before { content: '$'; color: var(--muted); margin-right: 0.05em; }

  .tag {
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0.12em 0.6em;
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-pill);
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--muted);
    white-space: nowrap;
    vertical-align: 0.12em;
  }
  .tag--star {
    color: var(--primary);
    border-color: color-mix(in oklch, var(--primary) 45%, transparent);
  }
</style>
