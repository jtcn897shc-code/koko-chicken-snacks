---
import { Image } from 'astro:assets';
import aboutImg from '../assets/about.jpg';
import { about } from '../data/site';
---

<section class="about section">
  <div class="shell about__grid">
    <div class="about__text" data-reveal-group>
      <h2 class="about__title" data-reveal>A small counter on Montrose</h2>
      {about.map((p) => <p class="about__p" data-reveal>{p}</p>)}
    </div>
    <figure class="about__figure" data-reveal>
      <Image
        src={aboutImg}
        alt="The KOKO counter at dusk, warm light over the order window and a short row of stools."
        widths={[420, 640, 960]}
        sizes="(max-width: 900px) 100vw, 40vw"
      />
    </figure>
  </div>
</section>

<style>
  .about { background: var(--surface); }
  .about__grid {
    display: grid;
    grid-template-columns: 1fr 0.8fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .about__title {
    font-size: var(--step-3);
    font-weight: 800;
    letter-spacing: -0.03em;
    max-width: 16ch;
  }
  .about__p {
    margin-top: var(--space-m);
    max-width: 60ch;
    line-height: 1.65;
    color: var(--ink);
  }
  .about__p:first-of-type { font-size: var(--step-1); color: var(--ink); }
  .about__figure {
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 4 / 5;
  }
  .about__figure :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 900px) {
    .about__grid { grid-template-columns: 1fr; }
    .about__figure { order: -1; aspect-ratio: 16 / 10; }
  }
</style>
