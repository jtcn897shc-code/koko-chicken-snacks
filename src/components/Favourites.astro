---
import { Image } from 'astro:assets';
import { favourites, reviews } from '../data/site';
import honeySoyGarlic from '../assets/fav-honey-soy-garlic.jpg';
import sweetSpicy from '../assets/fav-sweet-spicy.jpg';
import corndog from '../assets/fav-corndog.jpg';

const imgs: Record<string, ImageMetadata> = { honeySoyGarlic, sweetSpicy, corndog };
const alts: Record<string, string> = {
  honeySoyGarlic:
    'Boneless Korean fried chicken glazed in glossy honey soy garlic sauce, piled in a bowl with sesame seeds.',
  sweetSpicy:
    'Korean fried chicken coated in bright red gochujang sweet and spicy sauce, dusted with sesame and scallion.',
  corndog:
    'A Korean cheese corndog broken in half to show the melted mozzarella pull, crust dusted with sugar.',
};

const [feature, ...rest] = favourites;
---

<section class="faves section" id="favourites">
  <div class="shell">
    <header class="faves__head">
      <h2 class="faves__title">Order these first</h2>
    </header>

    <article class="feature" data-reveal>
      <div class="feature__media">
        <Image src={imgs[feature.img]} alt={alts[feature.img]} widths={[480, 720, 1080]} sizes="(max-width: 900px) 100vw, 55vw" />
      </div>
      <div class="feature__body">
        <h3 class="feature__name">{feature.name}</h3>
        <p class="feature__blurb">{feature.blurb}</p>
      </div>
    </article>

    <div class="minis" data-reveal-group>
      {
        rest.map((f) => (
          <article class="mini" data-reveal>
            <div class="mini__media">
              <Image src={imgs[f.img]} alt={alts[f.img]} widths={[360, 540, 720]} sizes="(max-width: 900px) 100vw, 40vw" />
            </div>
            <h3 class="mini__name">{f.name}</h3>
            <p class="mini__blurb">{f.blurb}</p>
          </article>
        ))
      }
    </div>

    <div class="quotes" data-reveal-group>
      {
        reviews.map((r) => (
          <blockquote class="quote" data-reveal>
            <p class="quote__text">{r.quote}</p>
            <cite class="quote__cite">
              {r.name}
              <span>{r.source}</span>
            </cite>
          </blockquote>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faves {
    background: var(--frame);
    color: var(--on-frame);
  }
  .faves__head { margin-bottom: var(--space-xl); }
  .faves__title {
    font-size: var(--step-4);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #fff;
  }

  .feature {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }
  .feature__media {
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }
  .feature__media :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .feature__name {
    font-size: var(--step-3);
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .feature__blurb {
    margin-top: var(--space-s);
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--muted-on-frame);
    max-width: 40ch;
  }

  .minis {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    padding-block: clamp(2rem, 5vw, 3.5rem);
    border-block: 1px solid var(--hairline-on-frame);
  }
  .mini__media {
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 5 / 4;
  }
  .mini__media :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .mini__name {
    margin-top: var(--space-s);
    font-size: var(--step-2);
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .mini__blurb {
    margin-top: 0.4rem;
    color: var(--muted-on-frame);
    line-height: 1.55;
    max-width: 38ch;
  }

  .quotes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 5vw, 4rem);
    margin-top: clamp(2rem, 5vw, 3.5rem);
  }
  .quote { margin: 0; }
  .quote__text {
    font-size: var(--step-2);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.015em;
    color: #fff;
    text-wrap: balance;
  }
  .quote__text::before { content: '\201C'; }
  .quote__text::after { content: '\201D'; }
  .quote__cite {
    display: block;
    margin-top: var(--space-s);
    font-style: normal;
    font-weight: 600;
    color: var(--on-frame);
  }
  .quote__cite span {
    display: block;
    font-weight: 400;
    font-size: var(--step--1);
    color: var(--muted-on-frame);
  }

  @media (max-width: 900px) {
    .feature { grid-template-columns: 1fr; }
    .minis { grid-template-columns: 1fr; }
    .quotes { grid-template-columns: 1fr; gap: 2rem; }
  }
</style>
