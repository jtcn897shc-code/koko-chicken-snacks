---
import { Image } from 'astro:assets';
import heroImg from '../assets/hero.jpg';
import { contact, orderLinks } from '../data/site';
---

<section class="hero" id="top">
  <div id="nav-sentinel" aria-hidden="true"></div>

  <div class="hero__media">
    <Image
      src={heroImg}
      alt="A paper-lined basket of Korean double-fried chicken, glossy with soy garlic sauce and scattered with sesame and sliced scallion."
      widths={[640, 960, 1440, 1920, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero__scrim" aria-hidden="true"></div>
  </div>

  <div class="hero__content shell">
    <p class="hero__place">{contact.neighbourhood}</p>
    <h1 class="hero__title">Double-fried.<br />Sauced to order.</h1>
    <p class="hero__sub">
      A short menu of Korean fried chicken and snacks. Order in, take out, or
      delivered across the Fraser Valley.
    </p>
    <div class="hero__actions">
      <a class="btn" href={orderLinks.uberEats} target="_blank" rel="noopener">
        Order on Uber Eats
      </a>
      <a class="btn btn--ghost btn--on-frame" href="#menu">See the menu</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: min(92svh, 760px);
    display: flex;
    align-items: flex-end;
    background: var(--frame);
    overflow: hidden;
  }

  #nav-sentinel {
    position: absolute;
    inset-block-start: 0;
    block-size: 1px;
    inline-size: 1px;
  }

  .hero__media { position: absolute; inset: 0; z-index: -1; }
  .hero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 55%;
  }

  /* Scrim: dark at the lower-left where the copy sits, clearing toward top-right.
     Guarantees text contrast over any photo. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, oklch(0.13 0.01 32 / 0.88) 0%, oklch(0.13 0.01 32 / 0.5) 42%, oklch(0.13 0.01 32 / 0.12) 74%, transparent 100%),
      linear-gradient(to right, oklch(0.13 0.01 32 / 0.6) 0%, oklch(0.13 0.01 32 / 0.14) 46%, transparent 68%);
  }

  .hero__content {
    padding-block: clamp(2.5rem, 6vw, 5rem);
    color: var(--on-frame);
    max-width: 62rem;
  }

  .hero__place {
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.01em;
    color: oklch(0.9 0.02 65);
    text-shadow: 0 1px 8px oklch(0.13 0.01 32 / 0.7);
    margin-bottom: var(--space-s);
  }

  .hero__title {
    font-size: var(--step-5);
    font-weight: 800;
    line-height: 0.96;
    letter-spacing: -0.035em;
    color: #fff;
    max-width: 20ch;
    text-wrap: balance;
  }

  .hero__sub {
    margin-top: var(--space-m);
    font-size: var(--step-1);
    line-height: 1.5;
    max-width: 46ch;
    color: oklch(0.92 0.008 70);
  }

  .hero__actions {
    margin-top: var(--space-l);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__media :global(img) {
      animation: hero-drift 22s var(--ease-out) infinite alternate;
    }
    @keyframes hero-drift {
      from { transform: scale(1); }
      to { transform: scale(1.06); }
    }
  }
</style>
